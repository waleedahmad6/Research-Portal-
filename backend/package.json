{
  "name": "research-portal-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Express REST API for the University Research Opportunity Portal",
  "main": "src/server.js",
  "scripts": {
    "prestart": "npm run db:generate",
    "start": "node src/server.js",
    "predev": "npm run db:generate",
    "dev": "nodemon src/server.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^18.0.7",
    "express": "^5.3.0",
    "@prisma/client": "^6.19.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.10",
    "prisma": "^6.19.0"
  }
}
